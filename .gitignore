debian/tmp/
debian/souran/
debian/.debhelper/
debian/files
debian/opt/
debian/usr/
debian/lib/
.souran-stage/
__pycache__/
*.pyc
config/*.key
config/*.pem
engine/unbound-src/

# Python virtualenv — 859 files were tracked here, which is ~78% of the
# repository and pure noise. It is regenerable with `python3 -m venv`.
.venv/
venv/
# Bytecode — regenerated on import, never source.
*.pyc
*.pyo
__pycache__/
# Vendored upstream trees: compiled from during the .deb build, never
# shipped in the payload.
engine/unbound-src/
censorship/zapret/
censorship/goodbyedpi/
censorship/byedpi/
# Prebuilt third-party binaries (Technitium .NET runtime).
dns/
# Runtime state — never source.
*.log
logs/
run/
toggles.conf
feature-state.json
client-ca/
__pycache__/

# Rust/cargo build output (125 files, ~40 MB of .rlib/.rmeta).
target/
# Compiled resolver binaries. The .deb build compiles these from
# engine/unbound-src, so committing prebuilt ones would contradict the
# from-source claim; root.hints and unbound-root.key ARE tracked, since
# they are data the resolver needs at runtime.
engine/unbound/sbin/
engine/unbound/lib/
engine/unbound/include/

# Rollback archive of the OLD resolver build. 11 MB of stale build
# output that `git add -A` picked up; shipping it would put a
# CVE-2026-85501-vulnerable binary in the public repository.
engine-unbound-*.tar.gz

# Runtime state, rewritten on every run. engine/unbound-root.key is the
# DNSSEC trust anchor and MUST ship -- it is public data -- so it is
# force-added by build-deb-payload.sh rather than ignored here.
config/souran-ca.srl
data/learning-engine.json

# Generated by souran_blocklists.py. 37 MB of derived rules, rebuilt in
# ~8 s from the cached lists. Tracking it would bloat the repo and the
# .deb with something reproducible.
config/blocklists/blocklist.conf
config/blocklists/compiled.json
