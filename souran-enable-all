#!/bin/bash
# Souran v5.0.0 — enable the full stack.
#
# Kept OUT of the package's automatic start path on purpose: this server
# claims port 53 and rewrites the host's DNS path, so activating it has to
# be a deliberate act. `dpkg -i souran_*.deb` installs and stops; this
# script is the "yes, actually turn it on" step.
set -euo pipefail

SOURAN_DIR="/opt/souran-ai"
UNITS=(
    souran-dns              # zero-upstream unbound core
    souran-doh-fallback     # poison-proof front-end owning :53
    souran-dns-dot          # DNS-over-TLS :853
    souran-8083-doh         # DNS-over-HTTPS :8083
    souran-sidecar          # control API :9192
    souran-8082-dashboard   # Hermes control dashboard :8082
    souran-web-8383         # web dashboard :8383
    souran-web3-resolver    # Web3/ENS :8086
    souran-gaming-dns       # gaming DNS :8087
    souran-learning-engine  # telemetry :8084
    souran-anticompress     # anti-compression :8085
    souran-ids              # intrusion detection
    souran-watchdog         # self-healing supervisor
)

echo "==> enabling ${#UNITS[@]} souran units"
fail=0
for u in "${UNITS[@]}"; do
    if [ ! -f "/etc/systemd/system/$u.service" ]; then
        echo "    skip   $u (unit not installed)"
        continue
    fi
    if sudo -n systemctl enable --now "$u" 2>/dev/null; then
        echo "    ok     $u"
    else
        echo "    FAILED $u"
        fail=$((fail + 1))
    fi
done

echo
echo "==> verifying DNS"
sleep 3
if command -v dig >/dev/null 2>&1; then
    if dig +short +time=8 +tries=1 @127.0.0.1 google.com A >/dev/null 2>&1; then
        echo "    DNS on :53 answering"
    else
        echo "    WARNING: :53 did not answer google.com — check"
        echo "             journalctl -u souran-doh-fallback"
    fi
fi

echo
if [ "$fail" -gt 0 ]; then
    echo "==> $fail unit(s) failed to start"
    exit 1
fi
echo "==> souran is live"
echo "    dashboard :8082 (Hermes control) / :8383 (web)"
echo "    token     sudo cat /etc/souran/api-token"
