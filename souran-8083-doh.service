# Version: v5.1.0 | Souran AI Network Server
[Unit]
Description=Souran DoH User Port (Port 8083)
After=network.target

[Service]
Type=simple
User=reza
WorkingDirectory=/home/reza/souran-kb/scripts
ExecStart=/usr/bin/python3 -m uvicorn souran_8083_doh:app --host 0.0.0.0 --port 8083
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
