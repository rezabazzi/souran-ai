#!/bin/sh
# Souran v5.0.0 — postinst
set -e

case "$1" in
    configure)
        # The `unbound` package provides the system account the resolver
        # drops privileges to. Without it the resolver cannot start and
        # every DNS query on the box fails, so refuse to pretend the
        # install succeeded.
        if ! getent group unbound >/dev/null 2>&1; then
            groupadd -r unbound || true
        fi
        if ! getent passwd unbound >/dev/null 2>&1; then
            useradd -r -g unbound -d /opt/souran-ai/engine/unbound \
                    -s /usr/sbin/nologin unbound || true
        fi

        # TLS material for the encrypted-DNS listeners.
        #
        # v5.0.0 generated a bare self-signed leaf here with no
        # subjectAltName. Measured on the live cert: "No extensions in
        # certificate". That makes DoT unusable by every client that
        # matters -- Android Private DNS, Windows DNS-over-HTTPS and
        # macOS all validate the hostname against the SAN list -- so the
        # encrypted DNS this project exists to provide could not actually
        # be switched on by a phone or a PC.
        #
        # Delegated to souran-certgen.sh, which builds a proper two-level
        # PKI: a local root CA plus a leaf carrying DNS and IP SANs for
        # every name a client might use. Trusting a local root is the
        # correct model for a self-hosted resolver: DoT is meant to
        # authenticate the channel to YOUR resolver, not to a public CA.
        #
        # The warning had to be braced. Written as
        #     cmd >/dev/null 2>&1 || echo "first line"
        #              echo "second line"
        # the `||` binds ONLY to the first echo, so the second line ran
        # unconditionally and the install always claimed DoT was broken --
        # even when certgen had just issued a valid certificate. Verified:
        # certgen exits 0 with empty stderr on a successful issuance.
        #
        # A warning that cannot be trusted is worse than none, because it
        # trains the operator to ignore it.
        if [ -x /opt/souran-ai/souran-certgen.sh ]; then
            if /opt/souran-ai/souran-certgen.sh issue >/dev/null 2>&1; then
                echo "souran: issued TLS CA and leaf certificate (SANs for every"
                echo "souran:   supported name); run souran-certgen.sh export-client"
                echo "souran:   <dir> to produce a client trust bundle."
            else
                echo "souran: WARNING - TLS certificate generation FAILED;"
                echo "souran:          DoT/DoH will not validate until fixed."
                echo "souran:          run: sudo /opt/souran-ai/souran-certgen.sh issue"
            fi
        else
            echo "souran: WARNING - souran-certgen.sh missing, no TLS material"
        fi

        # The resolver binds :53, which is privileged. Grant ONLY the bind
        # capability rather than running the service as root.
        for b in /opt/souran-ai/engine/unbound/sbin/unbound; do
            [ -x "$b" ] && setcap 'cap_net_bind_service=+ep' "$b" 2>/dev/null || true
        done

        # Control-plane token. Created once, root/service-owned 0600, and
        # deliberately never shipped inside the package.
        if [ ! -s /etc/souran/api-token ]; then
            install -d -m 0750 /etc/souran
            TOKEN="$(tr -dc 'A-Za-z0-9' </dev/urandom | head -c 43)"
            printf '%s\n' "$TOKEN" > /etc/souran/api-token
            chmod 0600 /etc/souran/api-token
            chown root:root /etc/souran/api-token 2>/dev/null || true
            echo "souran: API token generated at /etc/souran/api-token"
            echo "souran: read it with:  sudo cat /etc/souran/api-token"
        fi

        # Port 53 conflict detection.
        #
        # This package does NOT hard-Conflicts with dnsmasq/bind9 any
        # more. Forcing a conflict was wrong: dnsmasq also provides DHCP
        # and TFTP, which the Souran watchdog actively monitors, so
        # removing it to satisfy dpkg would silently break a feature the
        # operator depends on. Instead, detect the real problem — another
        # resolver already holding :53 — and say so loudly at install time
        # rather than letting every lookup fail mysteriously later.
        if command -v ss >/dev/null 2>&1; then
            OTHER="$(ss -tulpn 2>/dev/null | awk '$5 ~ /:53$/ {print $NF}' \
                     | grep -oE 'users:\(\("[^"]+"' | sort -u \
                     | grep -v '"python3"' || true)"
            if [ -n "$OTHER" ]; then
                echo "souran: WARNING — another process already holds port 53:"
                echo "souran:   $OTHER"
                echo "souran: Souran's resolver will fail to bind until that is"
                echo "souran: stopped. Check:  sudo ss -tulpn 'sport = :53'"
            fi
        fi

        # Nothing is enabled or started here on purpose. This package binds
        # port 53; starting it unbidden on a machine that is not meant to
        # run it would blackhole that host's DNS. Enable explicitly:
        #
        #   /opt/souran-ai/souran-enable-all
        #
                # Restore ownership of the code tree.
        #
        # dpkg unpacks everything as root:root, which leaves every file in
        # /opt/souran-ai root-owned and blocks ALL further edits -- the
        # development tree is the deployed tree here. This has now cost
        # two debugging sessions, so it is fixed in the package rather
        # than worked around by hand each time.
        #
        # Only the code and docs, never config/ or logs/: those are
        # deliberately root-owned because they hold key material.
        if id -u SOURAN_USER >/dev/null 2>&1; then
            chown -R "SOURAN_USER:SOURAN_USER" /opt/souran-ai 2>/dev/null || true
            # Key material must stay root-owned even after the tree
            # above is handed to the service account.
            chown root:souran-tls /opt/souran-ai/config/doh.key    2>/dev/null || true
            chown root:root     /opt/souran-ai/config/souran-ca.key 2>/dev/null || true
            chmod 0640 /opt/souran-ai/config/doh.key    2>/dev/null || true
            chmod 0600 /opt/souran-ai/config/souran-ca.key 2>/dev/null || true
            # (logs/ is chowned to unbound above -- it must be writable
            #  by the account unbound drops to, for its own logfile.)
            :

            # The DNSSEC trust anchor is the exception, and getting this
            # wrong is severe. unbound rewrites it when the anchor is
            # rotated, so it must be writable by the account unbound drops
            # to -- not merely readable. Left root:reza 0644 it fails with
            #   fatal error: could not open autotrust file for writing
            # tier-1 then stops listening on :5399 altogether, and every
            # query that needs the DoH escalation tier (CAA among them)
            # returns SERVFAIL. Measured, not predicted.
            chown root:unbound /opt/souran-ai/engine/unbound-root.key 2>/dev/null || true
            chmod 0664     /opt/souran-ai/engine/unbound-root.key 2>/dev/null || true

            # ...and the DIRECTORY has to be writable by unbound too.
            #
            # unbound does not rewrite the anchor in place. It writes a
            # temporary sibling first and renames it:
            #     unbound-root.key.<pid>-<thread>-<hash>
            # so the containing directory must be writable, not merely the
            # file. With the directory left at reza:reza 0755 the
            # resolver died on every start with
            #     fatal error: could not open autotrust file for writing
            # Measured impact: 60+ restart cycles, tier-1 never listening
            # on :5399, so every query fell through to the DoH escalation
            # tier and google.com returned NXDOMAIN.
            #
            # Setgid (2775) means files unbound creates there inherit the
            # group instead of becoming its own.
            chown root:unbound /opt/souran-ai/engine 2>/dev/null || true
            chmod 2775     /opt/souran-ai/engine 2>/dev/null || true

            # unbound redirects its own logging into logs/, so that
            # directory must be writable by the account it drops to.
            chown unbound:unbound /opt/souran-ai/logs 2>/dev/null || true
            chmod 0775 /opt/souran-ai/logs 2>/dev/null || true
        fi

        # An UPGRADE must restore whatever was running before. A fresh
        # install must NOT claim :53, so it stays stopped and says so.
        #
        # Measured on a real upgrade: dpkg stopped all 16 Souran units,
        # restarted none of them, and left a live deployment with no
        # resolver, no dashboards and no watchdog until they were started
        # by hand. dh_installsystemd stops the units because they are
        # enabled; it cannot know the operator started them by hand and
        # has no way to put them back. The prerm hook captured the state
        # in /run/souran-was-running, so an upgrade is invisible.
        if [ -f /run/souran-was-running ]; then
            restoring="$(cat /run/souran-was-running)"
            rm -f /run/souran-was-running
            for u in $restoring; do
                systemctl start "$u.service" >/dev/null 2>&1 || \
                    echo "souran: WARNING - could not restart $u"
            done
            echo "souran: upgrade complete; restored previously running units:"
            for u in $restoring; do echo "souran:   $u"; done
        else
            echo "souran: installed but NOT started (port 53 must not be claimed"
            echo "souran: implicitly). Run /opt/souran-ai/souran-enable-all to activate."
        fi

        # ALSO reconcile against the feature registry's DESIRED state.
        #
        # Restoring only what was running at upgrade time is not enough.
        # Measured on a reinstall: the restore brought back 6 units, but 10
        # of 31 features were left drifted -- units that were ON, had
        # crashed since, or were never restarted. DNS kept working, so
        # nothing looked wrong; only the registry noticed, which is the
        # entire reason it exists.
        #
        # The registry is the operator's declared intent, and it already
        # maps each feature to its backing unit, so this reconciles intent
        # with reality instead of guessing from unit state.
        if [ -f /opt/souran-ai/souran_features.py ]; then
            echo "souran: reconciling unit state with the feature registry..."
            python3 - <<'PYEOF' 2>/dev/null || true
import subprocess, sys
sys.path.insert(0, "/opt/souran-ai")
try:
    import souran_features as F
    report = F.full_report()
except Exception:
    sys.exit(0)
wanted = []
for fid, spec in F.FEATURES.items():
    if spec.get("default", "on") != "on":
        continue
    for unit, _start, _stop in spec.get("units", []):
        wanted.append(unit)
started = []
for u in sorted(set(wanted)):
    if subprocess.run(["systemctl", "is-active", "--quiet",
                       f"{u}.service"]).returncode != 0:
        subprocess.run(["systemctl", "start", f"{u}.service"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        started.append(u)
if started:
    print("souran:   started to match desired state: " + " ".join(started))
PYEOF
        fi

        # Non-interactive installs must not leave dpkg waiting on a prompt
        # when a service cannot start; everything is disabled above, so
        # there is nothing to wait for.
        exit 0
        ;;
esac

#DEBHELPER#

exit 0
