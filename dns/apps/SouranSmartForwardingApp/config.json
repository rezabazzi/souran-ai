{
  "appPreference": 210,
  "healthCheckIntervalSeconds": 15,
  "healthCheckTimeoutMs": 3000,
  "unhealthyThreshold": 3,
  "healthCheckDomain": "cloudflare.com",
  "routes": [
    {
      "name": "tor-dns",
      "forwarder": "127.0.0.1:9053",
      "protocol": "Udp",
      "priority": 10
    },
    {
      "name": "quad9-dot-fragmented",
      "forwarder": "tls://9.9.9.9",
      "protocol": "Tls",
      "priority": 50,
      "tlsFragmentation": {
        "enabled": true,
        "mode": "tcpSegment",
        "fragmentBytes": 1,
        "splitAtSni": true
      }
    },
    {
      "name": "cloudflare-dot-fragmented",
      "forwarder": "tls://1.1.1.1",
      "protocol": "Tls",
      "priority": 60,
      "tlsFragmentation": {
        "enabled": true,
        "mode": "tcpSegment",
        "fragmentBytes": 1,
        "splitAtSni": true
      }
    }
  ]
}
