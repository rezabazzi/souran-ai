[Unit]
Description=Souran AI Network Server — Web3 Resolver (Port 8086)
After=souran-doh-fallback.service souran-dns.service network-online.target
Wants=network-online.target souran-doh-fallback.service

[Service]
Type=simple
User=reza
WorkingDirectory=/opt/souran-ai
ExecStart=/usr/bin/python3 /opt/souran-ai/souran_web3_resolver.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
LimitNOFILE=65536
MemoryMax=256M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=souran-web3

[Install]
WantedBy=multi-user.target